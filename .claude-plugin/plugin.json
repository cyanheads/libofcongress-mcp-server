{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "libofcongress-mcp-server",
  "version": "0.2.18",
  "description": "Search LOC digital collections, browse Chronicling America newspapers with full OCR text, and look up LC Subject Headings via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/libofcongress-mcp-server#readme",
  "repository": "https://github.com/cyanheads/libofcongress-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "library-of-congress",
    "loc",
    "chronicling-america",
    "newspapers"
  ],
  "mcpServers": {
    "libofcongress-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/libofcongress-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_SESSION_MODE": "stateless"
      }
    }
  }
}
